# ===== 大二进制用 Git LFS 管理，见 .gitattributes =====
# （APK / libil2cpp.so / global-metadata.dat / dump.cs 已入库于 files/）

# ===== 内存 dump / frida-server（体积过大，不入库）=====
memdump*.bin
mem*.bin
seg_*.bin
fs
fs-arm64
frida-server*

# ===== 工具链（本机安装，不入库；用环境变量指向）=====
jdk/
ghidra/
ghidra_out/
install/
node_modules/
*.tgz
pkg/

# ===== 运行时缓存 / 中间产物 =====
# work/ 是 paths.unity_data_asset() 解 cache 的地方，不入库
work/
emu/memdump.bin
emu/seg_*.bin
emu/dump2/
emu/mem2.bin
emu/memd/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ===== 编辑器 =====
.vscode/
.idea/
*.swp
*~

# ===== 系统 =====
Thumbs.db
desktop.ini
.DS_Store

# 32 位 ARM 版 libil2cpp.so：从 APK 的 lib/armeabi-v7a 提取，50MB，可用 scripts/verify_arm32.py 重现
files/libil2cpp_arm32.so
